{
  "name": "task-manager-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de tareas con Express TypeScript MongoDB Atlas y JWT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "check": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "role:set": "tsx src/scripts/set-user-role.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "dotenv": "17.2.2",
    "express": "5.1.0",
    "jose": "6.2.12",
    "mongoose": "8.24.4",
    "cors": "2.8.6",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "@types/cors": "2.8.19"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.25.0"
}
