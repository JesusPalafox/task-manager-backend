{
  "name": "task-manager-backend",
  "version": "1.0.0",
  "description": "Aplicación de consola modular para gestionar tareas, construida con Node.js y TypeScript.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "serve": "node dist/index.js",
    "dev": "tsx watch src/server.ts",
"check": "tsc --noEmit",
"build": "tsc",
"start": "node dist/server.js"

  },
  "keywords": [
    "node",
    "typescript",
    "backend",
    "console"
  ],
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1"
  }
}